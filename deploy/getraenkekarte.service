[Unit]
Description=Digitale Getraenkekarte
After=network.target

[Service]
User=getraenkekarte
WorkingDirectory=/opt/getraenkekarte
EnvironmentFile=/etc/getraenkekarte.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/getraenkekarte/data

[Install]
WantedBy=multi-user.target
